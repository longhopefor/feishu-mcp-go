# 飞书API调试配置
# 复制此文件为 debug.env，并填入真实的配置信息

# 飞书应用配置
FEISHU_APP_ID=test
FEISHU_APP_SECRET=test
FEISHU_BASE_URL=https://open.feishu.cn/open-apis

# 测试用的文档和文件夹
TEST_FOLDER_TOKEN=xxx
TEST_DOCUMENT_ID=xxx
TEST_DOCUMENT_TITLE=API测试文档

# 内容操作工具测试配置
TEST_BLOCK_ID=xxx
TEST_PARENT_BLOCK_ID=xxx

# 测试用的知识库配置
TEST_WIKI_SPACE_ID=xxx
TEST_WIKI_NODE_TOKEN=xxx

# 调试配置
DEBUG_MODE=true
VERBOSE_MODE=true 