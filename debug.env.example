# 飞书API调试配置
# 复制此文件为 debug.env，并填入真实的配置信息

# 飞书应用配置
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_BASE_URL=https://open.feishu.cn/open-apis

# 测试用的文档和文件夹
TEST_FOLDER_TOKEN=your_test_folder_token_here
TEST_DOCUMENT_ID=your_test_document_id_here
TEST_DOCUMENT_TITLE=API测试文档

# 测试用的知识库配置
TEST_WIKI_SPACE_ID=your_wiki_space_id_here
TEST_WIKI_NODE_TOKEN=your_wiki_node_token_here

# 调试配置
DEBUG_MODE=true
VERBOSE_MODE=true 